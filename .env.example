APP_ENV=development
APP_NAME=VDL Starter
APP_DEBUG=true

# Préfixes appliqués centralement à tous les endpoints d'une même famille
# (voir app/app.php, registerActions()). Une action déclare un PATH relatif
# (ex. '/product') ; le préfixe le résout en route finale (ex. '/api/product').
API_REST_PREFIX=/api
API_RPC_PREFIX=/rpc

# Connexion Doctrine (MySQL/MariaDB par défaut). Requis uniquement si
# l'application compte au moins un Repository généré (voir
# composer make:repository, src/Repositories/NOM/NOMRepository.php) :
# sans Repository, ces variables peuvent rester absentes (app/app.php ne
# construit l'EntityManager que si un Repository existe).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vdl_starter
DB_USER=root
DB_PASSWORD=

# Origines autorisées pour les requêtes cross-origin (CORS), séparées par
# des virgules ; "*" par défaut (développement). À restreindre en production.
CORS_ALLOWED_ORIGINS=*

# Journalisation applicative (PSR-3 via Monolog)
# LOG_PATH est relatif à la racine du projet.
LOG_PATH=logs/app.log
LOG_LEVEL=debug

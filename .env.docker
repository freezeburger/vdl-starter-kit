# Variante de .env.example destinée à l'exécution via docker compose.
# Copier ce fichier en .env avant `docker compose up` :
#
#   copy .env.docker .env     (Windows)
#   cp .env.docker .env       (macOS/Linux)
#
# Seule différence structurelle avec .env.example : DB_HOST vaut le nom du
# service Docker ("db"), pas une adresse locale — un conteneur ne peut pas
# joindre MariaDB via 127.0.0.1, mais via le réseau Docker créé par
# docker-compose.yml, où chaque service est joignable par son nom.
#
# Ce même fichier .env est aussi lu par docker-compose.yml (mécanisme
# standard de Docker Compose : un fichier .env à la racine du projet sert
# de source de substitution ${VARIABLE} dans le compose file) : DB_NAME,
# DB_USER, DB_PASSWORD ci-dessous configurent donc à la fois le backend
# PHP et le service MariaDB — une seule source de vérité, pas de valeurs
# dupliquées à garder synchronisées. Voir DOCKER.md pour le détail.

APP_ENV=development
APP_NAME=VDL Starter
APP_DEBUG=true

API_REST_PREFIX=/api
API_RPC_PREFIX=/rpc

# Connexion Doctrine : "db" est le nom du service MariaDB dans docker-compose.yml.
DB_HOST=db
DB_PORT=3306
DB_NAME=vdl_starter
DB_USER=vdl
DB_PASSWORD=vdl

# Mot de passe root MariaDB : uniquement consommé par docker-compose.yml
# (service db), jamais par l'application PHP elle-même.
DB_ROOT_PASSWORD=root

CORS_ALLOWED_ORIGINS=*

LOG_PATH=logs/app.log
LOG_LEVEL=debug

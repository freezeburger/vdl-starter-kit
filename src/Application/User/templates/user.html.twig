<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Utilisateurs</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; }
        main { display: grid; grid-template-columns: minmax(22rem, 2fr) minmax(18rem, 1fr); gap: 2rem; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .65rem; border-bottom: 1px solid #ddd; text-align: left; }
        label { display: block; margin-top: 1rem; font-weight: 600; }
        input { box-sizing: border-box; width: 100%; padding: .6rem; }
        button { margin-top: 1rem; padding: .65rem 1rem; }
        .errors { color: #a40000; }
    </style>
</head>
<body>
    <h1>Utilisateurs</h1>
    <main>
        <section>
            <h2>Liste</h2>
            <table>
                <thead><tr><th>Nom</th><th>E-mail</th><th></th></tr></thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>{{ item.name }}</td>
                            <td>{{ item.email }}</td>
                            <td><a href="/user?id={{ item.id }}">Modifier</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3">Aucun utilisateur.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section>
            <h2>{{ selected and selected.id ? 'Détail' : 'Nouvel utilisateur' }}</h2>
            {% if errors %}
                <ul class="errors">
                    {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                </ul>
            {% endif %}
            <form method="post" action="/user">
                {% if selected and selected.id %}
                    <input type="hidden" name="id" value="{{ selected.id }}">
                {% endif %}
                <label for="name">Nom</label>
                <input id="name" name="name" required maxlength="100" value="{{ selected ? selected.name : '' }}">

                <label for="email">E-mail</label>
                <input id="email" name="email" type="email" required maxlength="180" value="{{ selected ? selected.email : '' }}">

                <button type="submit">Enregistrer</button>
                {% if selected and selected.id %}<a href="/user">Nouveau</a>{% endif %}
            </form>
        </section>
    </main>
</body>
</html>